<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#0E1015</color>
    <color name="surface">#161923</color>
    <color name="surface_variant">#232837</color>
    <color name="outline">#363C50</color>
    <color name="accent">#6EA8FF</color>
    <color name="accent_container">#1E3B6B</color>
    <color name="on_surface">#E8EAF0</color>
    <color name="on_surface_variant">#A4ABBD</color>
    <color name="heart">#FF5A7A</color>

    <style name="Theme.TvPlayer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#00224D</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">#D6E4FF</item>
        <item name="colorSecondary">#AFC3EA</item>
        <item name="colorSecondaryContainer">#2A3550</item>
        <item name="colorOnSecondaryContainer">#DCE6FA</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="bottomNavigationStyle">@style/Widget.TvPlayer.Nav</item>
    </style>

    <style name="Widget.TvPlayer.Nav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.TvPlayer.NavIndicator</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.TvPlayer.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/accent_container</item>
    </style>

    <style name="Widget.TvPlayer.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="TextAppearance.TvPlayer.Headline" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.TvPlayer.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
