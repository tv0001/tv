<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="4dp"
        android:paddingEnd="24dp"
        android:paddingBottom="4dp">

        <!-- programme replay (live channels that offer past programmes) -->
        <LinearLayout
            android:id="@+id/replayBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                style="@style/PlaySettingsLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="节目回看" />

            <TextView
                android:id="@+id/replayOpen"
                style="@style/PlaySettingsHint"
                android:layout_width="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="看看播过的节目 ›"
                android:textColor="@color/accent" />

        </LinearLayout>

        <!-- speed -->
        <LinearLayout
            android:id="@+id/speedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/PlaySettingsLabel"
                android:text="倍速" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/speedGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />

        </LinearLayout>

        <!-- picture fit -->
        <TextView
            style="@style/PlaySettingsLabel"
            android:layout_marginTop="20dp"
            android:text="画面" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/fitGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <!-- subtitles and audio tracks -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/PlaySettingsLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="字幕" />

            <TextView
                android:id="@+id/subtitleValue"
                style="@style/PlaySettingsHint"
                android:layout_width="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|end"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/accent" />

        </LinearLayout>

        <TextView
            android:id="@+id/importSub"
            style="@style/PlaySettingsHint"
            android:layout_width="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:text="导入字幕文件（srt / vtt / ass）"
            android:textColor="@color/accent" />

        <LinearLayout
            android:id="@+id/audioBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                style="@style/PlaySettingsLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="音轨" />

            <TextView
                android:id="@+id/audioValue"
                style="@style/PlaySettingsHint"
                android:layout_width="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|end"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/accent" />

        </LinearLayout>

        <!-- skip intro / outro -->
        <LinearLayout
            android:id="@+id/skipBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/PlaySettingsLabel"
                android:layout_marginTop="20dp"
                android:text="跳过片头 / 片尾" />

            <TextView
                style="@style/PlaySettingsHint"
                android:text="这部剧的每一集都生效，按住 + / − 可以连续调" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="片头"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_stepper"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/introMinus"
                        style="@style/Widget.TvPlayer.StepButton"
                        android:contentDescription="减少 5 秒"
                        android:text="−" />

                    <TextView
                        android:id="@+id/introLabel"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/introPlus"
                        style="@style/Widget.TvPlayer.StepButton"
                        android:contentDescription="增加 5 秒"
                        android:text="+" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="片尾"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_stepper"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/outroMinus"
                        style="@style/Widget.TvPlayer.StepButton"
                        android:contentDescription="减少 5 秒"
                        android:text="−" />

                    <TextView
                        android:id="@+id/outroLabel"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/outroPlus"
                        style="@style/Widget.TvPlayer.StepButton"
                        android:contentDescription="增加 5 秒"
                        android:text="+" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- sleep timer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                style="@style/PlaySettingsLabel"
                android:layout_width="wrap_content"
                android:text="睡眠定时" />

            <TextView
                android:id="@+id/sleepStatus"
                style="@style/PlaySettingsHint"
                android:layout_width="0dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:gravity="end" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/sleepGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <!-- leaving the app -->
        <LinearLayout
            android:id="@+id/leaveBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/PlaySettingsLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="切出 App 时" />

                <TextView
                    android:id="@+id/pipNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="立即小窗播放"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/leaveGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
