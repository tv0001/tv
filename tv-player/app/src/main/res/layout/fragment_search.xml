<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_search_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="0dp">

        <ImageView
            android:id="@+id/searchIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="13dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_search"
            android:src="@drawable/ic_search"
            app:tint="@color/on_surface_variant" />

        <EditText
            android:id="@+id/query"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/on_surface_variant"
            android:textSize="16sp" />

        <!-- 分类筛选（BrowseActivity） -->
        <ImageButton
            android:id="@+id/browse"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="分类筛选"
            android:src="@drawable/ic_tune"
            app:tint="@color/on_surface_variant" />

        <ImageButton
            android:id="@+id/phoneInput"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="用手机输入"
            android:src="@drawable/ic_phone"
            android:visibility="gone"
            app:tint="@color/on_surface_variant" />

        <ImageButton
            android:id="@+id/clear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="清除"
            android:src="@drawable/ic_clear"
            android:visibility="gone"
            app:tint="@color/on_surface_variant" />

    </LinearLayout>

    <!-- 电视上的首字母键盘：搜索框有焦点时出现（SearchFragment.buildKeyboard） -->
    <GridLayout
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:columnCount="10"
        android:visibility="gone" />

    <!-- 搜索联想：输入时出现，点一个直接搜 -->
    <HorizontalScrollView
        android:id="@+id/suggestBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/suggest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingVertical="0dp"
            app:singleLine="true" />

    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/historyBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingVertical="0dp"
                app:singleLine="true" />

        </HorizontalScrollView>

    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:trackCornerRadius="1dp"
        app:trackThickness="2dp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textAppearance="@style/TextAppearance.TvPlayer.Caption"
        android:textColor="@color/on_surface_variant"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/filterBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingVertical="0dp"
            app:singleLine="true" />

    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
        android:descendantFocusability="afterDescendants"
        android:focusable="false"
            android:id="@+id/results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/hot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Phones, tabs layout: one compact row above the tabs (continue watching and updated favorites). -->
            <LinearLayout
                android:id="@+id/hotExtra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/hotTabs"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@null"
                app:tabGravity="start"
                app:tabIndicatorColor="@color/accent"
                app:tabIndicatorFullWidth="false"
                app:tabInlineLabel="true"
                app:tabMode="scrollable"
                app:tabPaddingEnd="14dp"
                app:tabPaddingStart="14dp"
                app:tabRippleColor="@null"
                app:tabSelectedTextColor="@color/accent"
                app:tabTextColor="@color/on_surface_variant" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/hotGrid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp" />

            <com.tv.player.ui.RowScrollView
                android:id="@+id/hotRows"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fadingEdgeLength="40dp"
                android:focusable="false"
                android:overScrollMode="never"
                android:paddingTop="14dp"
                android:requiresFadingEdge="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/hotRowsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp" />

            </com.tv.player.ui.RowScrollView>

        </LinearLayout>

        <include
            android:id="@+id/empty"
            layout="@layout/view_empty" />

    </FrameLayout>

</LinearLayout>
