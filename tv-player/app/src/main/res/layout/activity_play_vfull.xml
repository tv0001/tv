<?xml version="1.0" encoding="utf-8"?>
<!-- Phones: a tall picture (short dramas) over the whole screen. Pull down on the small picture to get here, pull up to leave. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vroot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="true" />

    <ImageButton
        android:id="@+id/back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@drawable/bg_overlay_button"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_back" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="top"
        android:layout_marginStart="72dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="204dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:shadowColor="#99000000"
        android:shadowRadius="6"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/episodesBtn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="124dp"
        android:background="@drawable/bg_overlay_button"
        android:gravity="center"
        android:text="选集"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/cast"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/bg_overlay_button"
        android:contentDescription="@string/cast"
        android:src="@drawable/ic_cast" />

    <ImageButton
        android:id="@+id/playSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="68dp"
        android:background="@drawable/bg_overlay_button"
        android:contentDescription="播放设置"
        android:src="@drawable/ic_settings" />

</FrameLayout>
