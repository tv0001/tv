<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_settings"
            android:textAppearance="@style/TextAppearance.TvPlayer.Headline" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TvPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我的源"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Section" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="添加自己的点播接口或直播列表，给每个源单独开关、测速、删除。"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Caption"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/manageSources"
                    style="@style/Widget.TvPlayer.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="管理点播源和直播源" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/phonePush"
                    style="@style/Widget.TvPlayer.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="用手机给电视输入（扫码）" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TvPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="订阅更新"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Section" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="从下面的目录下载 best.json（点播源）和 live.txt（直播源），打开 App 时每 12 小时自动更新一次。App 里内置了一份，网络不通也能用。"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Caption"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="订阅目录地址">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/base"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri" />

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/update"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="立即更新" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/reset"
                        style="@style/Widget.TvPlayer.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="恢复默认地址" />

                </LinearLayout>

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Caption"
                    android:textColor="@color/accent" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TvPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="导入配置"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Section" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="粘贴一个地址，自动识别：TVBox 配置 JSON（取其中的 CMS 点播源），或 TXT / M3U 直播列表。"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Caption"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="配置或直播列表地址">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/importUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/importBtn"
                    style="@style/Widget.TvPlayer.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="导入" />

                <TextView
                    android:id="@+id/importStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Caption"
                    android:textColor="@color/accent" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TvPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="备份与恢复"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Section" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="把订阅、收藏、观看历史、搜索历史导出成一个文件，换设备时导入。"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Caption"
                    android:textColor="@color/on_surface_variant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/exportBtn"
                        style="@style/Widget.TvPlayer.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="导出备份" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/restoreBtn"
                        style="@style/Widget.TvPlayer.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="导入备份" />

                </LinearLayout>

                <TextView
                    android:id="@+id/backupStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Caption"
                    android:textColor="@color/accent" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TvPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="当前数据"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Section" />

                <TextView
                    android:id="@+id/info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="4dp"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clearHistory"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-12dp"
                    android:text="清除搜索历史" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TvPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关于投屏"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Section" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="4dp"
                    android:text="投屏使用 DLNA：手机和电视连同一个 Wi-Fi，电视上打开投屏 / DLNA 接收功能（例如当贝投屏、乐播投屏、小米电视自带投屏）。在播放页点“投屏”选择设备即可。"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Caption"
                    android:textColor="@color/on_surface_variant" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TvPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="显示与播放"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Section" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="自动：按设备判断（最短边 600dp 以上当平板）。有些电视盒子不会把自己报告成电视，界面不对时在这里手动选。"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Caption"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/uiMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/modeAuto"
                        style="@style/Widget.TvPlayer.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="自动" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/modePhone"
                        style="@style/Widget.TvPlayer.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="手机" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/modeTablet"
                        style="@style/Widget.TvPlayer.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="平板" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/modeTv"
                        style="@style/Widget.TvPlayer.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="电视" />

                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="电视界面大小"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Section" />

                <TextView
                    android:id="@+id/screenInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Caption"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/tvScale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/scaleSmall"
                        style="@style/Widget.TvPlayer.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="偏小" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/scaleAuto"
                        style="@style/Widget.TvPlayer.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="自动" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/scaleLarge"
                        style="@style/Widget.TvPlayer.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="偏大" />

                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="热播推荐样式"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Section" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="顶部标签：剧集、电影、综艺、动漫分页切换，一页一个网格。分组横滑：几个榜单上下排开，每个榜单左右滑。"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Caption"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/hotLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/hotLayoutTabs"
                        style="@style/Widget.TvPlayer.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="顶部标签" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/hotLayoutRows"
                        style="@style/Widget.TvPlayer.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="分组横滑" />

                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="热播榜来源"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Section" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="自动：用豆瓣榜单，连不上时改用各站点的最近更新。榜单取不到，或者想少依赖外网，可以直接选“站点最近更新”。"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Caption"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/hotMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/hotAuto"
                        style="@style/Widget.TvPlayer.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="自动" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/hotCms"
                        style="@style/Widget.TvPlayer.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="站点最近更新" />

                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="选线方式"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Section" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="智能：开播前对各条线路测速，先保证流畅，再在流畅的线路里挑最清晰的。每次要下载一两 MB，所以用流量时默认不测。手动点过某条线路就以你选的为准。"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Caption"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/lineMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/lineSmart"
                        style="@style/Widget.TvPlayer.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="智能" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/lineSmartAlways"
                        style="@style/Widget.TvPlayer.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="智能（流量下也测）" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/lineOrder"
                        style="@style/Widget.TvPlayer.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="按顺序" />

                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TvPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="夸克网盘"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Section" />

                <TextView
                    android:id="@+id/panStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/panLogin"
                    style="@style/Widget.TvPlayer.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="扫码登录" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/panOpen"
                    style="@style/Widget.TvPlayer.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="打开我的网盘" />

                <TextView
                    android:id="@+id/panWebStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/panWeb"
                    style="@style/Widget.TvPlayer.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="扫码登录（转存分享用）" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/panShare"
                    style="@style/Widget.TvPlayer.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="添加分享链接" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TvPlayer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="应用更新"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Section" />

                <TextView
                    android:id="@+id/version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.TvPlayer.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/checkUpdate"
                    style="@style/Widget.TvPlayer.TonalButton"
                    android:layout_width="match_parent"
